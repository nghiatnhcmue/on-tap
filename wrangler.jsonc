{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "on-tap",
  "main": "worker/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "on-tap-nghiaedu-tin-hoc",
    "FIREBASE_DB_URL": "https://on-tap-nghiaedu-tin-hoc-default-rtdb.asia-southeast1.firebasedatabase.app"
  }
}
